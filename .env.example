# ============================================================
# AI-Based Intelligent Source Code Optimization and Analysis Agent
# Environment configuration template.
#
# Copy this file to backend/.env and fill in the values.
# NEVER commit a real .env file or a real API key to source control.
# ============================================================

# --- LLM (AI Optimization Agent) ---------------------------------------
# API key for the Groq API. Required for the /api/analyze pipeline's
# AI stage. If missing, analysis will fail at the "ai_analysis" stage with
# a clear error message rather than a fake/mocked result.
LLM_API_KEY=

# LLM provider used by the AI optimization agent.
LLM_PROVIDER=groq

# Groq model used to generate optimization proposals.
LLM_MODEL=openai/gpt-oss-20b

# Maximum tokens the LLM may generate for its JSON response.
LLM_MAX_TOKENS=4096

# --- Compiler configuration ---------------------------------------------
# Compiler executable used to build both the original and optimized code.
# Must be reachable on PATH. Use "clang++" if you prefer Clang.
CXX_COMPILER=g++

# C++ standard used for compilation.
CXX_STD=c++17

# Max seconds allowed for a single compilation.
COMPILE_TIMEOUT_SECONDS=20

# --- Execution / sandbox configuration ----------------------------------
# Max seconds allowed for a single program run (per test case / per
# benchmark iteration).
EXECUTION_TIMEOUT_SECONDS=5

# Max accepted size (bytes) of submitted source code.
MAX_SOURCE_SIZE_BYTES=200000

# Max accepted size (bytes) of a single test case's stdin.
MAX_STDIN_SIZE_BYTES=50000

# Number of repeated runs used when benchmarking each version.
BENCHMARK_RUNS=7

# --- Server configuration -----------------------------------------------
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Comma-separated list of origins allowed to call the API (CORS).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Report storage -------------------------------------------------------
# Directory (relative to the backend/ working directory) where JSON
# analysis reports are persisted for GET /api/report/{id}.
REPORT_STORE_DIR=./data/reports
